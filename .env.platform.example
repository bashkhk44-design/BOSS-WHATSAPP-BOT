# Dedicated platform-bot webhook ingress and queue worker.
# SAFE DEFAULT: Render health-only mode; no Telegram bot runtimes or queue worker start.
# Change to enabled only after explicit staging acceptance and approval.
PLATFORM_BOT_WEBHOOK_MODE=disabled

# Use only a dedicated staging/test PostgreSQL database.
DATABASE_URL=postgresql://TEST_USER:TEST_PASSWORD@YOUR-STAGING-HOST/neondb?sslmode=require
DATABASE_SSL=require
# Required only when webhook mode is explicitly enabled; same isolated DB, direct non-pooler endpoint.
DATABASE_DIRECT_URL=postgresql://TEST_USER:TEST_PASSWORD@YOUR-STAGING-DIRECT-HOST/neondb?sslmode=require
BOTS_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHAR_TEST_KEY

# Required only after webhook mode is explicitly enabled; never use production bot tokens.
TELEGRAM_BOT_TOKEN=REPLACE_WITH_STAGING_MASTER_BOT_TOKEN
TELEGRAM_ADMIN_ID=REPLACE_WITH_TEST_ADMIN_NUMERIC_ID
INTAKE_BOT_TOKEN=REPLACE_WITH_STAGING_INTAKE_BOT_TOKEN

# Required only for webhook ingress activation; independent random values.
MASTER_WEBHOOK_SECRET=REPLACE_WITH_INDEPENDENT_RANDOM_MASTER_SECRET
INTAKE_WEBHOOK_SECRET=REPLACE_WITH_INDEPENDENT_RANDOM_INTAKE_SECRET

PORT=8082
QUEUE_POLL_INTERVAL_MS=1000
QUEUE_LEASE_SECONDS=120
