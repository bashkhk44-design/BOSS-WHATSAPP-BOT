# انسخ هذا الملف إلى .env.worker.local ولا ترفع الملف المحلي إلى Git.
# استخدم DATABASE_URL لفرع Neon التجريبي فقط، وليس قاعدة الإنتاج.
BOSS_WORKER_MODE=termux-test
BOSS_TEST_DATABASE=YES
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-TEST-NEON-HOST/neondb?sslmode=require
DATABASE_SSL=require
BOTS_ENCRYPTION_KEY=REPLACE_WITH_THE_EXISTING_64_CHARACTER_HEX_KEY
QUEUE_POLL_INTERVAL_MS=1500
QUEUE_LEASE_SECONDS=120
WORKER_DB_POOL_MAX=2
