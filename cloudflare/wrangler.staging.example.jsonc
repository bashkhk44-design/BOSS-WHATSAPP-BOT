{
  "name": "boss-bot-platform-ingress-staging",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-17",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "vars": {
    "PLATFORM_BOT_WEBHOOK_MODE": "disabled",
    "CUSTOMER_BOT_WEBHOOK_MODE": "disabled"
  },
  // Configure these as Worker secrets, never as vars or committed values:
  // wrangler secret put MASTER_WEBHOOK_SECRET
  // wrangler secret put INTAKE_WEBHOOK_SECRET
  // wrangler secret put CUSTOMER_WEBHOOK_SECRET
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "REPLACE_WITH_VERIFIED_STAGING_HYPERDRIVE_ID"
    }
  ]
}
